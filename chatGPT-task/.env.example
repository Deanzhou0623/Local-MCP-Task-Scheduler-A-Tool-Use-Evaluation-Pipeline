# Database location for the SQLite job store.
DATABASE_URL=sqlite:///./chatgpt_task.db

# How often (in seconds) the watcher scans for due jobs.
WATCHER_INTERVAL=10

# --- Eval provider API keys (Spec 07/08) ----------------------------------
# Only needed to run evals against a real model (--model <provider>:<id>).
# With no key set, the eval falls back to the local heuristic model.
# Copy this file to .env and fill in the keys you have. .env is gitignored.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# google-genai reads GEMINI_API_KEY (or GOOGLE_API_KEY as a fallback).
GEMINI_API_KEY=
GOOGLE_API_KEY=
